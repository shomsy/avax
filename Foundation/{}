    /**
     * @param callable $callback fn(mixed $item): bool
     * @return array{0: array, 1: array}
     */
    public function partition(callable $callback): array
    {
        $pass = [];
        $fail = [];

        foreach ($this->items as $item) {
            if ($callback($item)) {
                $pass[] = $item;
            } else {
                $fail[] = $item;
            }
        }

        return [$pass, $fail];
    }

    public function getItems(): array
    {
        return $this->items;
    }
}
