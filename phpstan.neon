includes:
    - vendor/rector/type-perfect/config/extension.neon
    - vendor/phpstan/phpstan-phpunit/extension.neon
    - phpstan-baseline.neon

parameters:
    level: 8
    paths:
        - framework
        - components
        - tests
    excludePaths:
        - vendor
        - '*/MiddlewarePipelineFailed.php'
    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
        -
            message: '#Call to .* on a separate line has no effect#'
            path: 'framework/System/Capabilities/Benchmarks/MicroBenchmarkRunner.php'
        -
            message: '#Property .* is never read, only written#'
        - '#Constructor of class.*has an unused parameter#'
        - '#Parameters should have .* types as the only types passed to this method#'
        - '#Mixed variable in a `\$file->\.\.\.\(\)` can skip important errors#'
        -
            identifier: 'method.returnType'
            message: '#.*returns CheckInterface but returns CheckInterface\.#'
            path: 'framework/System/Capabilities/PreCommit/PreCommit.php'
        -
            message: '#.*Aws\\.*#'
            path: 'components/Integration/ObjectStorage/System/Capabilities/StoreObjects/StoreObjectsOnS3.php'
        -
            message: '#Call to an undefined method object::.*#'
            path: 'components/Integration/ObjectStorage/System/Capabilities/StoreObjects/StoreObjectsOnS3.php'
        -
            message: '#Mixed variable.*#'
            path: 'components/Integration/ObjectStorage/System/Capabilities/StoreObjects/StoreObjectsOnS3.php'
        -
            message: '#Method .* is unused#'
            path: 'components/Integration/ObjectStorage/System/Capabilities/StoreObjects/StoreObjectsOnS3.php'
        -
            message: '#Instantiated class Aws\\.* not found#'
            path: 'components/Integration/ObjectStorage/System/Capabilities/StoreObjects/StoreObjectsOnS3.php'
        -
            message: '#Property.*MaterializedViewRegistry::\$views.*does not specify its types.*#'
        -
            message: '#Method.*MaterializedViewRegistry::staleViews\(\).*does not specify its types.*#'
        -
            message: '#Method.*MaterializedViewRegistry::staleViews\(\).*return type has no value type.*#'
        -
            message: '#PHPDoc tag @implements has invalid value.*#'
        -
            message: '#Call to static method PHPUnit.*will always evaluate to (true|false)#'
            path: 'tests/Unit/Framework/V4Runtime/ReactRuntimeAndWarmSafetyTest.php'
        -
            message: '#Call to static method PHPUnit.*assertArrayHasKey.*will always evaluate to true#'
            path: 'tests/Unit/Framework/V4Runtime/ReactRuntimeAndWarmSafetyTest.php'
        -
            message: '#Call to method PHPUnit\\Framework\\Assert::.*will always evaluate to (true|false)#'
            path: 'tests/Unit/Components/API/SchemaGeneration'
        -
            message: '#Call to method PHPUnit\\Framework\\Assert::.*will always evaluate to (true|false)#'
            path: 'tests/Unit/Components/DataStack/DataTransfer'
        -
            message: '#Call to method PHPUnit\\Framework\\Assert::.*will always evaluate to (true|false)#'
            path: 'tests/Unit/Components/DataStack/Data'
        -
            message: '#Strict comparison using === between .* will always evaluate to#'
            path: 'tests/Unit/Components/API/SchemaGeneration'
        -
            message: '#Parameter \$class of class .*DataShape constructor expects class-string, string given#'
            path: 'tests/Unit/Components/API/SchemaGeneration'
        -
            message: '#Parameter \$dataObject of method .*GenerateSchemaFromDataObject::execute\(\) expects#'
            path: 'tests/Unit/Components/API/SchemaGeneration'
        -
            message: '#Parameter \$payload of method .*ValidatePayloadAgainstSchema::execute\(\) expects#'
            path: 'tests/Unit/Components/API/SchemaGeneration'
        -
            message: '#Property .* has unknown class .* as its type#'
            path: 'tests/Unit/Components/API/SchemaGeneration'
        -
            message: '#Property .* type has no value type specified in iterable type array#'
            path: 'tests/Unit/Components/API/SchemaGeneration'
        -
            message: '#Call to method PHPUnit\\Framework\\Assert::assertIsArray.*will always evaluate to true#'
            path: 'tests/Unit/Components/API/SchemaGeneration'
        -
            message: '#Parameter .+ of method .*CreateDataObject::create\(\) expects class-string<NonExistentClass>, string given#'
            path: 'tests/Unit/Components/DataStack/DataTransfer/CreateDataObjectTest.php'
        -
            message: '#Call to an undefined method Traversable.*#'
            path: 'tests/Unit/Components/DataStack/DataTransfer/AttributeReadingTest.php'
        -
            message: '#Mixed variable in a.*can skip important errors#'
            path: 'tests/Unit/Components/DataStack/DataTransfer/AttributeReadingTest.php'
        -
            message: '#Access to an undefined property object::\$#'
            path: 'tests/Unit/Components/DataStack/DataTransfer/AttributeReadingTest.php'
        -
            message: '#Parameter .+ of function json_decode expects string, string\|false given#'
            path: 'tests/Unit/Components/DataStack/DataTransfer/DataTransferViolationsTest.php'
        -
            message: '#Parameter .+ of method .*ArrayReader::getArray\(\) expects#'
            path: 'tests/Unit/Components/DataStack/Data/ArrayReaderTest.php'
        -
            message: '#Call to method PHPUnit\\Framework\\Assert::assertSame.*will always evaluate to false#'
            path: 'tests/Unit/Components/DataStack/Data/ArrayReaderTest.php'
        -
            message: '#Call to method PHPUnit\\Framework\\Assert::assertSame.*will always evaluate to false#'
            path: 'tests/Unit/Components/DataStack/Data/ArrayWriterTest.php'
        -
            message: '#Mixed variable in a.*can skip important errors#'
            path: 'tests/Unit/Components/DataStack/Data/ArrhaeTest.php'
        -
            message: '#Use explicit methods over array access on object#'
            path: 'tests/Unit/Components/DataStack/Data/CollectionTest.php'
        -
            message: '#Mixed property fetch.*can skip important errors#'
            path: 'tests/Unit/Components/DataStack/DataTransfer/AttributeReadingTest.php'
        -
            message: '#Call to function property_exists.*will always evaluate to true#'
            path: 'tests/Unit/Components/DataStack/DataTransfer/CreateDataObjectTest.php'
        -
            message: '#Property .* type has no value type specified in iterable type array#'
            path: 'tests/Unit/Components/DataStack/DataTransfer/SerializeDataObjectTest.php'
        -
            message: '#Call to method PHPUnit\\Framework\\Assert::.*will always evaluate to (true|false)#'
            path: 'tests/Unit/Components/Application/Filesystem'
        -
            message: '#Call to method PHPUnit\\Framework\\Assert::.*will always evaluate to (true|false)#'
            path: 'tests/Unit/Components/Application/Storage'
        -
            message: '#Call to static method PHPUnit\\Framework\\Assert::assertInstanceOf.*will always evaluate to true#'
            path: 'tests/Unit/Components/Application/Storage'
        -
            message: '#Method .* return type has no value type specified in iterable type array#'
            path: 'tests/Unit/Components/Application/Storage'
        -
            message: '#.*PHPUnit.*invoked with named argument.*@no-named-arguments#'
            path: 'tests/Unit/Components/DataStack/Database'
        -
            message: '#.*PHPUnit.*invoked with named argument.*@no-named-arguments#'
