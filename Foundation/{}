                                                              'redirect_uri' => 'https://rp.example.test/callback',
                                                              'scope'        => 'openid email profile',
                                                              'nonce'        => 'nonce-par-http',
                                                          ]
                                              ));
        $logout    = $surface->execute(input: new HttpEndpointInput(
                                                  method: 'GET',
                                                  path  : '/oidc/logout',
                                                  query : [
                                                              'session_id' => $auth->current()->sessionId(),
