    {
        foreach ($this->providers() as $provider) {
            $claims = $provider->resolveIdToken(idToken: $idToken);

            if ($claims !== null) {
                return $claims;
            }
        }

        return null;
    }

    public function resolveJwt(#[SensitiveParameter] string $jwt) : array|null
    {
        foreach ($this->providers() as $provider) {
            $claims = $provider->resolveJwt(jwt: $jwt);

            if ($claims !== null) {
                return $claims;
            }
        }

        return null;
