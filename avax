#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * Avax CLI Tool - The primary entry point for Avax components.
 */

// Determine the root directory
$rootDir = __DIR__;
while ( ! file_exists(filename: $rootDir . '/vendor/autoload.php') && $rootDir !== dirname(path: $rootDir) ) {
    $rootDir = dirname(path: $rootDir);
}

// Bootstrap application
require_once $rootDir . '/vendor/autoload.php';

use Avax\Database\Integrations\Console\MigrateCommand;
use Avax\Database\Integrations\Console\MigrateRollbackCommand;
use Avax\Database\Integrations\Console\MigrateStatusCommand;
use Avax\Database\System\Capabilities\Migrations\CreateMigration\MigrationGenerator;
use Avax\Database\System\Capabilities\Migrations\ExportDatabase\DatabaseExporter;
use Avax\Database\System\Capabilities\Migrations\LoadMigrations\MigrationLoader;
use Avax\Database\System\Capabilities\Migrations\RunMigrations\MigrationRepository;
use Avax\Database\System\Capabilities\Migrations\RunMigrations\MigrationRunner;
use Avax\Database\System\Capabilities\Query\Builder\QueryBuilder;
use Avax\Framework\System\Flows\RunDoctor\RunDoctor;
use Avax\Migrations\Execution\Console\DatabaseCreateCommand;
use Avax\Migrations\Execution\Console\DatabaseDropCommand;
use Avax\Migrations\Execution\Console\DatabaseExportCommand;
use Avax\Migrations\Execution\Console\DatabaseSeedCommand;
use Avax\Migrations\Execution\Console\MigrateCommand as LegacyMigrateCommand;
use Avax\Migrations\Execution\Console\MigrateMakeCommand;
use Avax\Migrations\Execution\Console\MigrateRollbackCommand as LegacyMigrateRollbackCommand;
use Avax\Migrations\Execution\Console\MigrateStatusCommand as LegacyMigrateStatusCommand;
use Avax\Migrations\Execution\Console\Operations\TableDropCommand;
use Avax\Migrations\Execution\Console\Operations\TableTruncateCommand;
use Avax\Migrations\Execution\Repository\MigrationRepository as LegacyMigrationRepository;
use Avax\Migrations\Execution\Runner\MigrationRunner as LegacyMigrationRunner;
use Avax\Migrations\Export\DatabaseExporter as LegacyDatabaseExporter;
use Avax\Migrations\Generate\MigrationGenerator as LegacyMigrationGenerator;
use Avax\Migrations\Generate\MigrationLoader as LegacyMigrationLoader;

// Get dependencies from container
$repository = app(abstract: LegacyMigrationRepository::class);
$runner     = app(abstract: LegacyMigrationRunner::class);
$builder    = app(abstract: QueryBuilder::class);
$loader     = new LegacyMigrationLoader();
$generator  = new LegacyMigrationGenerator();
$exporter   = new LegacyDatabaseExporter(builder: $builder);

// Migrations directory
$migrationsPath = $rootDir . '/database/migrations';
$seedersPath    = $rootDir . '/database/seeders';
$exportPath     = $rootDir . '/database/exports';

$command = $argv[1] ?? 'help';
$arg1    = $argv[2] ?? null;
$arg2    = $argv[3] ?? null;

try {
    switch ($command) {
        case 'db:create':
            if (! $arg1) {
                echo "Database name required.\n";
                exit(1);
            }
            exit(new DatabaseCreateCommand(builder: $builder)->handle(name: $arg1));

        case 'db:drop':
            if (! $arg1) {
                echo "Database name required.\n";
                exit(1);
            }
            exit(new DatabaseDropCommand(builder: $builder)->handle(name: $arg1));

        case 'db:export':
            $table = null;
            $path  = $exportPath;
            if ($arg1 && str_starts_with(haystack: $arg1, needle: '--table=')) {
                $table = substr(string: $arg1, offset: 8);
                $path  = $arg2 ?? $exportPath;
            } else {
                $path = $arg1 ?? $exportPath;
            }
            exit(new DatabaseExportCommand(exporter: $exporter)->handle(path: $path, table: $table));

        case 'db:seed':
            exit(new DatabaseSeedCommand()->handle(seedersPath: $seedersPath, class: $arg1));

        case 'table:drop':
            if (! $arg1) {
                echo "Table name(s) required. Separate multiple with comma.\n";
                exit(1);
            }
            exit(new TableDropCommand(builder: $builder)->handle(tables: $arg1));

        case 'table:truncate':
            if (! $arg1) {
                echo "Table name(s) required. Separate multiple with comma.\n";
                exit(1);
            }
            exit(new TableTruncateCommand(builder: $builder)->handle(tables: $arg1));

        case 'migrate':
        case 'run':
            $dryRun = ($arg1 === '--dry' || $arg2 === '--dry');
        exit(new LegacyMigrateCommand(repository: $repository, runner: $runner, loader: $loader)->handle(path: $migrationsPath, dryRun: $dryRun));

        case 'make':
            $options = [];
            if ($arg2 && str_starts_with(haystack: $arg2, needle: '--create=')) {
                $options['table']  = substr(string: $arg2, offset: 9);
                $options['create'] = true;
            } elseif ($arg2 && str_starts_with(haystack: $arg2, needle: '--table=')) {
                $options['table'] = substr(string: $arg2, offset: 8);
            }
            exit(new MigrateMakeCommand(generator: $generator)->handle(name: $arg1, path: $migrationsPath, options: $options));

        case 'rollback':
            exit(new LegacyMigrateRollbackCommand(repository: $repository, runner: $runner, loader: $loader)->handle(path: $migrationsPath, steps: (int) ($arg1 ?? 1)));

        case 'status':
            exit(new LegacyMigrateStatusCommand(repository: $repository, loader: $loader)->handle(path: $migrationsPath));

        case 'runtime:doctor':
            $workerMode = ($arg1 === '--worker' || $arg2 === '--worker');
            exit((new RunDoctor())->handle(workerMode: $workerMode));

        case 'architecture:check':
            $archDir = $rootDir . '/tooling/architecture';
            $scripts = [
                'check-forbidden-folders.php',
                'check-public-surface.php',
                'check-runtime-leaks.php',
                'check-namespace-drift.php',
                'check-duplicate-owners.php',
                'check-docs-mirror.php',
            ];
            $hasErrors = false;
            foreach ($scripts as $script) {
                echo "\033[36mRunning {$script}...\033[0m\n";
                $result = 0;
                passthru('php ' . escapeshellarg($archDir . '/' . $script), $result);
                if ($result !== 0) {
                    $hasErrors = true;
                }
                echo "\n";
            }
            if ($hasErrors) {
                echo "\033[31mArchitecture checks failed!\033[0m\n";
                exit(1);
            }
            echo "\033[32mAll architecture checks passed successfully.\033[0m\n";
            exit(0);

        case 'help':
        default:
            echo "\033[33mAvax Framework CLI\033[0m\n\n";
            echo "Usage: php avax [command] [arguments]\n\n";
            echo "\033[32mDatabase Commands:\033[0m\n";
            echo "  db:create <name>       Create a new database\n";
            echo "  db:drop <name>         Drop an existing database\n";
            echo "  db:export [options]    Export database or table to SQL file\n";
            echo "  db:seed [class]        Seed the database with records\n\n";
            echo "\033[32mTable Operations:\033[0m\n";
            echo "  table:drop <tables>     Drop one or more tables (comma separated)\n";
            echo "  table:truncate <tables> Truncate one or more tables (comma separated)\n\n";
            echo "\033[32mMigration Commands:\033[0m\n";
            echo "  migrate            Run all pending migrations\n";
            echo "  make <name>        Create a new migration file\n";
            echo "  rollback [steps]   Rollback the last batch of migrations\n";
            echo "  status             Show the status of all migrations\n\n";
            echo "\033[32mArchitecture Commands:\033[0m\n";
        echo "  architecture:check   Run all static architecture guards\n";
        echo "  runtime:doctor       Inspect runtime safety and state leaks\n";
        echo "  runtime:doctor --worker  Check if app is safe for long-lived workers\n";
            exit(0);
    }
} catch (Throwable $e) {
    echo "\033[31mError: {$e->getMessage()}\033[0m\n";
    exit(1);
}
