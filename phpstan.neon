parameters:
    level: max
    paths:
        - framework
        - tooling
        - tests/Unit/Framework
        - tests/Feature/Framework
        - tests/Contract/Runtime
    excludePaths:
        - vendor
    checkMissingIterableValueType: true
    checkGenericClassInNonGenericObjectType: true
    reportUnmatchedIgnoredErrors: true
    ignoreErrors:
        -
            message: '#ResponseFactory#'
            path: framework/System/Flows/HandleIncomingHttp/HandleIncomingHttp.php
