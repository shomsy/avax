        }

        $this->entries[] = [
            'time'      => $this->clock->now(),
            'action'    => $action,
            'serviceId' => $serviceId,
            'outcome'   => $outcome,
        ];
    }

    /**
     * Reports whether timeline recording is enabled.
     */
    public function enabled() : bool
    {
        return $this->enabled;
    }

    /**
     * Returns the recorded timeline entries.
     */
    public function all() : array
    {
        return $this->entries;
    }

    /**
     * Clears all recorded timeline entries.
     */
    public function reset() : void
    {
        $this->entries = [];
    }
