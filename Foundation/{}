namespace Avax\HTTP\Session\SessionAudit;

use Psr\Log\LoggerInterface;
use Throwable;

final class Audit
{
    private LoggerInterface|null $logger;
    private string|null $logPath;
    private                      $sessionContext;
    private                      $httpContext;

    public function __construct(
        LoggerInterface|null $logger = null,
        string|null          $logPath = null,
                             $httpContext = null,
                             $sessionContext = null
    )
    {
        $this->httpContext = $httpContext;
        $this->sessionContext = $sessionContext;
        $this->logger      = $logger;
        $this->logPath     = $logPath;
    }

    public function record(string $event, array $data = []) : void
    {
        $sessionId = $data['session_id'] ?? ($this->sessionContext?->sessionId() ?? null);
        $userId    = $data['user_id'] ?? ($this->sessionContext?->userId() ?? null);
        $clientIp  = $this->httpContext?->clientIp() ?? null;

        $payload = [
            'timestamp'   => date('c'),
            'event'       => strtoupper($event),
            'environment' => getenv('APP_ENV') ?: 'production',
            'session_id'  => $sessionId,
            'user_id'     => $userId,
            'ip_address'  => $clientIp,
            'action_data' => $this->sanitize($data),
        ];

        try {
            $this->logger?->info('[SESSION_AUDIT]', $payload);
        } catch (Throwable $e) {
            if ($this->logPath) {
                $this->writeToFile($payload);
            }
        }
    }

    private function resolveClientIp() : string|null
    {
        return $this->httpContext?->clientIp();
    }

    private function sanitize(array $data) : array
    {
        $blacklist = ['password', 'token', 'api_key', 'secret'];
        $clean = [];

        foreach ($data as $key => $value) {
            if (is_array($value)) {
                $clean[$key] = $this->sanitize($value);
                continue;
            }

            $clean[$key] = in_array($key, $blacklist, true)
                ? '***MASKED***'
                : $value;
        }

        return $clean;
    }

    private function writeToFile(array $payload) : void
    {
        $json = json_encode($payload, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES);
        $dir  = dirname($this->logPath);

        if (! is_dir($dir)) {
            mkdir($dir, 0775, true);
        }

        file_put_contents($this->logPath, $json . PHP_EOL, FILE_APPEND | LOCK_EX);
    }

    private function resolveUserId() : int|null
    {
        $userId = $this->sessionContext?->userId();
        if (is_int($userId)) {
            return $userId;
        }
        return null;
    }
}
