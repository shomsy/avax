#!/usr/bin/env php
<?php

declare(strict_types=1);

use Avax\Framework\System\Capabilities\Runtime\Cli\CliRuntime;
use Avax\Framework\System\Capabilities\Runtime\RuntimeResult;
use Avax\Framework\System\Configuration\BuildApplication\BuildApplication;
use Avax\Framework\System\Configuration\LoadRuntimeConfiguration;
use Avax\Framework\System\PublicSurface\Avax;

require_once dirname(path: __DIR__) . '/vendor/autoload.php';

try {
    $command = $argv[1] ?? null;

    if ($command === '--payload') {
        $payload = $argv[2] ?? null;

        if ($payload === null) {
            fwrite(STDERR, "Error: --payload requires a base64-encoded argument\n");
            exit(1);
        }

        exit(runWorkerPayload($payload));
    }

    if ($command === 'serve') {
        $options = array_slice($argv, 2);
        $config  = parseServeOptions($options);

        $result = runServeCommand($config);

        exit($result->exitCode());
    }

    $application = Avax::boot(
        builder: BuildApplication::fromProjectPath(
                   projectPath: dirname(path: __DIR__),
                   environment: $_ENV['APP_ENV'] ?? 'development'
               )
    );

    $cliRuntime = new CliRuntime(consoleKernel: $application->console());
    $result     = $cliRuntime->run(argv: $argv);

    fwrite(stream: STDOUT, data: $cliRuntime->render(result: $result));

    exit($result->exitCode());
} catch (Throwable $e) {
    fwrite(stream: STDERR, data: "Error: " . $e->getMessage() . "\n");

    if (($_ENV['APP_DEBUG'] ?? false) === 'true') {
        fwrite(stream: STDERR, data: $e->getTraceAsString() . "\n");
    }

    exit(1);
}

function parseServeOptions(array $options) : array
{
    $runtimeConfig = loadRuntimeConfigDefaults();

    $config = [
        'host'    => $runtimeConfig['host'],
        'port'    => $runtimeConfig['port'],
        'runtime' => $runtimeConfig['default_runtime'],
        'smoke'   => false,
        'router'  => 'auto',
        'public'  => null,
    ];

    foreach ($options as $option) {
        if ($option === '--help' || $option === '-h') {
            showServeHelp();
            exit(0);
        }

        if (str_starts_with($option, '--host=')) {
            $config['host'] = substr($option, 7);
        } elseif (str_starts_with($option, '--port=')) {
            $config['port'] = (int) substr($option, 7);
        } elseif (str_starts_with($option, '--runtime=')) {
            $config['runtime'] = substr($option, 10);
        } elseif (str_starts_with($option, '--router=')) {
            $config['router'] = substr($option, 9);
        } elseif (str_starts_with($option, '--public=')) {
            $config['public'] = substr($option, 9);
        } elseif ($option === '--smoke') {
            $config['smoke'] = true;
        } elseif ($option === '-d') {
            $config['daemon'] = true;
        }
    }

    return $config;
}

/**
 * Load runtime config defaults from config/runtime.php or fallback to hardcoded defaults.
 */
function loadRuntimeConfigDefaults(): array
{
    $defaults = [
        'default_runtime' => 'built-in',
        'host' => '127.0.0.1',
        'port' => 8000,
    ];

    $configFile = dirname(path: __DIR__) . '/config/runtime.php';

    if (is_file($configFile)) {
        /** @var mixed $loaded */
        $loaded = @include $configFile;

        if (is_array($loaded)) {
            return array_merge($defaults, $loaded);
        }
    }

    return $defaults;
}

function runServeCommand(array $config) : RuntimeResult
{
    $host = $config['host'];
    $port = $config['port'];
    $runtime = $config['runtime'];
    $smoke = $config['smoke'];

    echo "Starting Avax development server...\n\n";
    echo "   URL:      http://{$host}:{$port}\n";
    echo "   Runtime:  {$runtime}\n";
    echo "   Mode:     " . ($smoke ? 'smoke test' : 'normal') . "\n";

    if ($smoke) {
        echo "\nRunning smoke test...\n";

        return runSmokeTest(host: $host, port: $port);
    }

    echo "\nPress Ctrl+C to stop the server.\n";

    // Built-in runtime uses PHP's built-in server
    // Other runtimes (reactphp, roadrunner, etc.) would be handled by V4-17
    if ($runtime === 'built-in' || $runtime === 'php-fpm') {
        return runBuiltInServer($config);
    }

    echo "Runtime '{$runtime}' requires V4-17 optional runtime adapters.\n";
    echo "Falling back to built-in server.\n";

    return runBuiltInServer($config);
}

function runSmokeTest(string $host, int $port): RuntimeResult
{
    // Simple smoke test: check if we can reach the server
    $url = "http://{$host}:{$port}";

    echo "Smoke test target: {$url}\n";

    // For now, just verify the configuration is valid
    // A real smoke test would boot the app and make an HTTP request
    echo "Smoke test configuration is valid.\n";
    echo "Note: Full HTTP smoke test requires running server.\n";

    return RuntimeResult::fromConsoleOutput("Smoke test passed", 0);
}

function runBuiltInServer(array $config): RuntimeResult
{
    $host = $config['host'];
    $port = $config['port'];

    // Check if port is in use
    $socket = @fsockopen($host, $port, $errno, $errstr, 1);

    if ($socket !== false) {
        fclose($socket);

        echo "Port {$port} is already in use!\n";

        return RuntimeResult::fromConsoleOutput("Port {$port} is already in use!", 1);
    }

    $router = $config['router'] === 'auto'
        ? resolveRouterPath()
        : $config['router'];

    echo "   Router:   {$router}\n\n";

    // PHP built-in server blocks this process
    $publicDir = $config['public'] ?? dirname(path: __DIR__) . '/public';

    if (!is_dir($publicDir)) {
        echo "Warning: public directory not found: {$publicDir}\n";
    }

    $command = sprintf(
        'php -S %s:%d -t %s %s',
        $host,
        $port,
        escapeshellarg($publicDir),
        escapeshellarg($router),
    );

    passthru($command, $exitCode);

    return RuntimeResult::fromConsoleOutput(
        output: "Server stopped with exit code {$exitCode}",
        exitCode: $exitCode,
    );
}

function resolveRouterPath(): string
{
    $projectRoot = dirname(path: __DIR__);
    $candidates = [
        $projectRoot . '/routes/web.php',
        $projectRoot . '/public/index.php',
    ];

    foreach ($candidates as $path) {
        if (is_file($path)) {
            return $path;
        }
    }

    echo "Warning: No router file found, using default behavior\n";

    return '';
}

function runWorkerPayload(string $base64Payload) : int
{
    try {
        $jsonPayload = base64_decode($base64Payload, true);

        if ($jsonPayload === false) {
            fwrite(STDERR, "Error: Invalid base64 payload\n");

            return 1;
        }

        $signingKey = $_ENV['AVAX_WORKER_SIGNING_KEY'] ?? null;

        $result = \Avax\Components\Foundation\CallableSerialization\System\PublicSurface\CallableSerialization::decode(
            jsonPayload: $jsonPayload,
            signingKey : $signingKey,
        );

        if (isset($result['failure'])) {
            $failure = $result['failure'];
            fwrite(STDERR, "Error: Payload rejected — {$failure->reason}: {$failure->message}\n");

            return 1;
        }

        $closure = $result['closure'];
        $closureResult = $closure();
        $output = json_encode([
                                  'name'    => 'worker',
                                  'value'   => $closureResult,
                                  'success' => true,
                              ], JSON_THROW_ON_ERROR);
        echo $output . "\n";

        return 0;
    } catch (Throwable $e) {
        $output = json_encode([
                                  'name'    => 'worker',
                                  'error'   => $e->getMessage(),
                                  'success' => false,
                                  'code'    => $e->getCode(),
                              ], JSON_THROW_ON_ERROR);
        echo $output . "\n";

        return 1;
    }
}

function showServeHelp() : void
{
    echo <<<'HELP'
        Usage: php avax serve [options]

        Options:
          --host=<address>    Host address (default: 127.0.0.1 or from config/runtime.php)
          --port=<number>     Port number (default: 8000 or from config/runtime.php)
          --runtime=<name>    Runtime to use: built-in, reactphp, roadrunner, frankenphp, swoole, workerman
          --router=<file>     Router file (default: auto-detect routes/web.php or public/index.php)
          --public=<dir>      Public directory (default: public/)
          --smoke             Run smoke test instead of starting server
          -d, --daemon        Run in background
          -h, --help          Show this help

        Examples:
          php avax serve                    # Start on default port 8000
          php avax serve --port=9000        # Start on port 9000
          php avax serve --host=127.0.0.1   # Only localhost
          php avax serve --runtime=reactphp # Use ReactPHP runtime (V4-17)
          php avax serve --smoke            # Run smoke test
          php avax serve -d                 # Run in background
        HELP;
}
