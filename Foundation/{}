    {
        if (! isset($this->pools[$tenantId])) {
            if (count(value: $this->pools) >= $this->maxTenants) {
                throw new RuntimeException(message: "Max tenants reached: {$this->maxTenants}");
            }

            $this->pools[$tenantId] = ($this->poolFactory)($tenantId);
