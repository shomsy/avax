declare(strict_types=1);

namespace Avax\Foundation\DataModeling\Tests\Collection;

/**
 * Characterization tests for Collection fluent API.
 */
final class CollectionCharacterizationTest extends \PHPUnit\Framework\TestCase
{
    private function collection(array $items = []): \Avax\DataModeling\Collection
    {
        return new \Avax\DataModeling\Collection(items: $items);
    }

    /** READ OPERATIONS */

    public function testAllReturnsItems(): void
    {
        $items = ['a' => 1, 'b' => 2];
        $col = $this->collection(items: $items);

        $this->assertSame($items, $col->all());
    }

    public function testGetReturnsValueByKey(): void
    {
        $col = $this->collection(items: ['name' => 'Alice', 'age' => 30]);

