    {
        foreach ($items as $key => $value) {
            $newKey = $prefix . $separator . $key;

            if (is_array(value: $value)) {
                $result = $this->flattenRecursive(result: $result, prefix: $newKey, items: $value, separator: $separator);
            } else {
                $result[$newKey] = $value;
            }
        }

        return $result;
    }

    public function getItems() : array
    {
        return $this->items;
    }
