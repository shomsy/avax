    {
        $userId = $this->emailVerificationStore->consume(token: $data->token, now: $this->clock->now());

        if ($userId === null) {
            $this->auditLog->record(event: new AuditEvent(
                                               name      : 'auth.email_verification.failed',
                                               occurredAt: $this->clock->now(),
                                               context   : [
