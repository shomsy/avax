    public function closeAll() : void
    {
        foreach ($this->pools as $pool) {
            $pool->destroy();
        }
        $this->pools = [];
    }

    public function getStats() : array
    {
        $stats = [];
        foreach ($this->pools as $tenantId => $pool) {
            $stats[$tenantId] = $pool->stats();
        }

        return $stats;
