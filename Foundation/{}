        = [
            'inline.service' => 'resolveInlineService',
        ];

    public function resolveInlineService(mixed $resolver, ResolveRequest $request, array $overrides) : string
    {
        return 'compiled:' . $request->serviceId . ':' . ($overrides['suffix'] ?? 'none');
    }
