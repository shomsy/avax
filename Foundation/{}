                                                          ]
                                              ));
        $jwks      = $surface->execute(input: new HttpEndpointInput(
                                                  method: 'GET',
                                                  path  : '/.well-known/jwks.json'
                                              ));
        $userInfo  = $surface->execute(input: new HttpEndpointInput(
                                                  method : 'GET',
                                                  path   : '/oidc/userinfo',
                                                  headers: ['Authorization' => 'Bearer ' . $grant->accessToken]
