{
  "license": "proprietary",
  "autoload": {
    "psr-4": {
      "Avax\\Framework\\": "framework/",
      "Avax\\Components\\": "components/"
    },
    "files": [
      "components/compat.php",
      "components/Application/Text/System/PublicSurface/shortcuts.php",
      "components/HTTP/Router/System/PublicSurface/shortcuts.php",
      "components/HTTP/Response/System/PublicSurface/shortcuts.php",
      "components/Operations/Logging/System/PublicSurface/shortcuts.php",
      "components/Application/Config/System/PublicSurface/shortcuts.php",
      "components/Identity/Auth/System/PublicSurface/shortcuts.php",
      "components/Presentation/View/System/PublicSurface/shortcuts.php",
      "components/HTTP/Session/System/PublicSurface/shortcuts.php",
      "components/HTTP/Context/System/PublicSurface/shortcuts.php",
      "components/DataStack/Data/System/PublicSurface/shortcuts.php",
      "components/DataStack/Database/System/PublicSurface/shortcuts.php",
      "components/Application/Container/System/PublicSurface/shortcuts.php",
      "components/HTTP/Security/System/PublicSurface/shortcuts.php",
      "components/DeveloperTools/DumpDebugger/System/PublicSurface/shortcuts.php",
      "components/Security/System/PublicSurface/Security.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Avax\\Tests\\": "tests/"
    },
    "files": [
      "tests/TestCase.php"
    ]
  },
  "require-dev": {
    "phpstan/phpstan": "^1.12",
    "rector/rector": "^1.2",
    "friendsofphp/php-cs-fixer": "^3.63",
    "squizlabs/php_codesniffer": "^3.7",
    "qossmic/deptrac": "^2.0",
    "nunomaduro/phpinsights": "^2.11",
    "barryvdh/laravel-ide-helper": "^3.1",
    "tracy/tracy": "^2.3",
    "phpstan/phpdoc-parser": "^2.3",
    "phpunit/phpunit": "^10.5",
    "swoole/ide-helper": "^5.1",
    "nikic/php-parser": "^5.7"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "phpstan/extension-installer": true,
      "infection/extension-installer": true
    },
    "audit": {
      "block-insecure": false
    }
  },
  "require": {
    "php": ">=8.5",
    "ext-pdo": "*",
    "ext-gmp": "*",
    "dragonmantank/cron-expression": "^3.6",
    "vlucas/phpdotenv": "^5.6",
    "guzzlehttp/guzzle": "^7.9",
    "rector/type-perfect": "^0.1.8",
    "symfony/var-dumper": "^7.1",
    "spatie/ignition": "^1.15",
    "meridius/yadup": "^1.1",
    "ext-simplexml": "*",
    "psr/log": "^3.0",
    "psr/container": "^2.0",
    "ext-fileinfo": "*",
    "firebase/php-jwt": "^6.10",
    "eftec/bladeone": "^4.16",
    "ramsey/uuid": "^4.7",
    "jenssegers/blade": "^2.0",
    "clickfwd/yoyo": "^0.2.0",
    "illuminate/view": "^11.7",
    "sentry/sentry": "^4.10",
    "amphp/amp": "^3.0",
    "amphp/parallel-functions": "^2.0",
    "ext-curl": "*",
    "wyndow/fuzzywuzzy": "^0.6.0",
    "rakibtg/sleekdb": "^2.15",
    "psr/simple-cache": "^3.0",
    "ext-intl": "*",
    "ext-openssl": "*",
    "ext-redis": "*",
    "psr/http-message": "^2.0"
  },
  "scripts": {
    "analyse": "phpstan analyse --memory-limit=1G",
    "style": "php-cs-fixer fix --dry-run --diff",
    "style:fix": "php-cs-fixer fix",
    "architecture": "deptrac analyse",
    "refactor:dry": "rector process --dry-run",
    "refactor": "rector process",
    "test": "phpunit",
    "check:superglobals": "php scripts/check-superglobals.php",
    "docs:validate": "php tooling/docs/validate-docs.php",
    "docs:mirror": "php tooling/docs/validate-docs-mirror-source.php",
    "runtime:leaks": "php tooling/refactor/check-runtime-leaks.php"
  }
}
