namespace Avax\Auth\System\Capabilities\IdentitySync\SCIM\Runtime\Bulk;

final readonly class ScimBulkOperation
{
    /** @var array<string, mixed> */
    public array       $body;

    /**
     * @param array<string, mixed> $body
