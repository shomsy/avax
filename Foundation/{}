     * @throws NotFoundExceptionInterface
     * @throws ReflectionException
     */
    public function execute(RouteDefinition $route, ServerRequest $request) : ResponseInterface
    {
        return $this->controllerDispatcher->dispatch(
            action : $route->action,
            request: $request
        );
    }
