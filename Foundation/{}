namespace Avax\HTTP\Session\SessionRecovery;

use Avax\Foundation\HTTP\Session\Foundation\SafeSerializer;
use Avax\Foundation\HTTP\Session\SessionAudit\SessionAudit;
use Avax\Foundation\HTTP\Session\SessionStore\SessionStore;
use Exception;
use Throwable;

final class Recovery
{
    private const string DEFAULT_BACKUP = 'default';
    private array $backups = [];
    public bool               $inTransaction      = false;
    private string|null       $currentTransaction = null;
    private SessionAudit|null $audit;
    private SessionStore      $store;

    public function __construct(SessionStore $store, SessionAudit|null $audit = null)
    {
        $this->store = $store;
        $this->audit = $audit;
    }

    public function snapshot(string $name = self::DEFAULT_BACKUP) : void
    {
        $this->backup($name);
    }

    public function backup(string $name = self::DEFAULT_BACKUP) : void
    {
        $data = $this->store->all();
        $this->backups[$name] = [
            'data' => $data,
            'timestamp' => time(),
            'hash' => hash('sha256', serialize($data)),
        ];
    }

    public function beginTransaction() : void
    {
        if ($this->inTransaction) {
            throw new Exception('Transaction already started');
        }

        $this->currentTransaction = 'tx_' . uniqid();
        $this->backup($this->currentTransaction);
        $this->inTransaction = true;
    }

    public function commit() : void
    {
        if (! $this->inTransaction) {
            throw new Exception('No active transaction');
        }
        if ($this->currentTransaction === null) {
            throw new Exception('Invalid transaction state');
        }

        $backupName = $this->currentTransaction;
        $this->deleteBackup($backupName);
        $this->currentTransaction = null;
        $this->inTransaction = false;

        $this->audit?->record('transaction_committed', ['backup' => $backupName]);
    }

    public function deleteBackup(string $name = self::DEFAULT_BACKUP) : bool
    {
        if (! isset($this->backups[$name])) {
            return false;
        }
        unset($this->backups[$name]);
        return true;
    }

    public function rollback() : void
    {
        if (! $this->inTransaction) {
            throw new Exception('No active transaction');
        }
        if ($this->currentTransaction === null) {
            throw new Exception('Invalid transaction state');
        }

        $backupName = $this->currentTransaction;
        $this->restore($backupName);
        $this->deleteBackup($backupName);
        $this->currentTransaction = null;
        $this->inTransaction = false;

        $this->audit?->record('transaction_rollback', ['backup' => $backupName]);
    }

    public function restore(string $name = self::DEFAULT_BACKUP) : bool
    {
        if (! isset($this->backups[$name])) {
            return false;
        }

        $backup = $this->backups[$name];

        if (isset($backup['hash'])) {
            $expected = $backup['hash'];
            $current = hash('sha256', serialize($backup['data']));

            if (! hash_equals($expected, $current)) {
                throw new Exception('Integrity check failed');
            }
        }

        $this->store->flush();
        foreach ($backup['data'] as $key => $value) {
            $this->store->put($key, $value);
        }

        return true;
    }

    public function hasBackup(string $name = self::DEFAULT_BACKUP) : bool
    {
        return isset($this->backups[$name]);
    }

    public function listBackups() : array
    {
        return array_keys($this->backups);
    }

    public function getBackupInfo(string $name = self::DEFAULT_BACKUP) : array|null
    {
        if (! isset($this->backups[$name])) {
            return null;
        }

        return [
            'name' => $name,
            'timestamp' => $this->backups[$name]['timestamp'],
            'size' => count($this->backups[$name]['data']),
            'age'  => time() - $this->backups[$name]['timestamp'],
        ];
    }

    public function clearAllBackups() : void
    {
        $this->backups = [];
    }

    public function transaction(callable $operation, string $backupName = '') : mixed
    {
        $backupName = $backupName ?: 'transaction_' . uniqid();
        $this->backup($backupName);

        try {
            $result = $operation();
            $this->deleteBackup($backupName);

            $this->audit?->record('transaction_committed', ['backup' => $backupName]);
            return $result;
        } catch (Throwable $e) {
            $this->restore($backupName);
            $this->deleteBackup($backupName);

            $this->audit?->record('transaction_rolled_back', ['backup' => $backupName, 'error' => $e->getMessage()]);

            throw new Exception('Transaction failed: ' . $e->getMessage());
        }
    }

    public function export() : string
    {
        $serializer = new SafeSerializer();

        return $serializer->serialize($this->store->all());
    }

    public function import(string $data) : bool
    {
        try {
            $serializer  = new SafeSerializer();
            $sessionData = $serializer->unserialize($data);

            if (! is_array($sessionData)) {
                return false;
            }

            $this->store->flush();
            foreach ($sessionData as $key => $value) {
                $this->store->put($key, $value);
            }

            return true;
        } catch (Throwable) {
            return false;
        }
    }
}
