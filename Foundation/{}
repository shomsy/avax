                    'scenario'        => $scenario,
                    'timeRatioVsPeer' => $timeRatio,
                    'peakRatioVsPeer' => $peakRatio,
                    'threshold'       => $threshold,
                ];
            }
        }

        $payload['comparisons'][$peerName] = [
            'scenarioCount' => count(value: $peerRows),
            'scenarios'     => $peerRows,
        ];
    }

    return $payload;
}

