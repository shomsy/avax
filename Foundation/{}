            $regressed  = $timeRatio > $threshold['max_time_ratio_vs_peer']
                || $peakRatio > $threshold['max_peak_ratio_vs_peer'];

            $peerRows[$scenario] = [
                'current'         => $currentRow,
                'peer'            => $peerRow,
                'timeRatioVsPeer' => $timeRatio,
                'peakRatioVsPeer' => $peakRatio,
                'threshold'       => $threshold,
                'regressed'       => $regressed,
