        return in_array(needle: $normalized, haystack: self::all(), strict: true)
            ? $normalized
            : self::PUBLIC;
    }

    /**
     * @return list<string>
     */
    public static function all() : array
    {
        return [
            self::PRIVATE,
            self::SHARED,
            self::PUBLIC,
            self::INTERNAL,
        ];
    }
}
