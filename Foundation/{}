namespace Avax\Foundation\DataModeling\Collections\Search;

use Avax\Foundation\DataModeling\Collections\Internal\SearchThreshold;
use FuzzyWuzzy\Fuzz;

final class MatchTextFuzzily
{
    private ?object $fuzz = null;

    public function __construct(
        private array $items = [],
    ) {}

    public function __invoke(string $query, int $threshold = 70, ?string $key = null) : array
    {
        return $this->match($query, $threshold, $key);
    }

    public function match(string $query, int $threshold = 70, ?string $key = null) : array
    {
        new SearchThreshold(value: $threshold);

        if (! class_exists('FuzzyWuzzy\Fuzz')) {
            return array_values($this->items);
        }

        $fuzz = new Fuzz();

        $filtered = array_filter(
            array   : $this->items,
            callback: function (mixed $item) use ($query, $threshold, $key, $fuzz) : bool {
                $target = $key !== null ? ($item[$key] ?? '') : $item;

                if (! is_string($target)) {
                    return false;
                }

                return $fuzz->ratio(
                        strtolower($query),
                        strtolower($target)
                    ) >= $threshold;
            }
        );

        return array_values($filtered);
    }

    public function getItems() : array
    {
        return $this->items;
    }
}
