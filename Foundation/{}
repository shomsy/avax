    }

    public function compileZone(string $zone) : string
    {
        return "ALTER RANGE {$zone} CONFIGURE ZONE";
    }

    public function compileRegionalInTable(string $region) : string
    {
        return "REGIONAL BY TABLE IN {$region}";
    }
