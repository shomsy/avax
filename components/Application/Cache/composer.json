{
  "name": "avax/cache",
  "description": "Enterprise-grade cache system with comprehensive value lifecycle, storage abstraction, and consistency guarantees",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "cache",
    "caching",
    "ttl",
    "invalidation",
    "cache-store",
    "system-design"
  ],
  "require": {
    "php": ">=8.5",
    "ext-redis": "*",
    "psr/simple-cache": "^3.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "Avax\\Cache\\": "."
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Avax\\Cache\\Tests\\": "tests/"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "config": {
    "sort-packages": true
  }
}
