== MailChannel ==
     1	<?php
     2	
     3	declare(strict_types=1);
     4	
     5	namespace Avax\Components\Operations\Notifications\System\Capabilities\Channels;
     6	
     7	use Avax\Components\Operations\Mail\System\Capabilities\Content\MimeMessage;
     8	use Avax\Components\Operations\Mail\System\Capabilities\Transport\MailTransport;
     9	use Avax\Components\Operations\Notifications\System\Capabilities\MailNotificationContent;
    10	use Avax\Components\Operations\Notifications\System\Capabilities\Notification;
    11	use Avax\Components\Operations\Notifications\System\Capabilities\NotificationChannel;
    12	
    13	/**
    14	 * Mail channel for sending notifications via email.
    15	 */
    16	final readonly class MailChannel implements NotificationChannel
    17	{
    18	    public function __construct(
    19	        private MailTransport $mailTransport,
    20	        private string $fromAddress = 'notifications@example.com',
    21	    ) {
    22	    }
    23	
    24	    public function send(mixed $notifiable, Notification $notification): void
    25	    {
    26	        $mailContent = $notification->toMail();
    27	        if (! $mailContent instanceof MailNotificationContent) {
    28	            return;
    29	        }
    30	
    31	        $email = $this->resolveEmail($notifiable);
    32	        if ($email === null) {
    33	            return;
    34	        }
    35	
    36	        $subject = $mailContent->subject ?: 'Notification';
    37	        $body = $this->buildBody($mailContent);
    38	
    39	        $mimeMessage = new MimeMessage(
    40	            from       : $this->fromAddress,
    41	            to         : $email,
    42	            subject    : $subject,
    43	            body       : $body,
    44	            contentType: 'text/html',
    45	        );
    46	
    47	        // Create a minimal envelope
    48	        $envelope = new readonly class ($this->fromAddress, $email) {
    49	            public function __construct(
    50	                public string $from,
    51	                public string $to,
    52	            ) {
    53	            }
    54	        };
    55	
    56	        $this->mailTransport->send($mimeMessage, $envelope);
    57	    }
    58	
    59	    private function resolveEmail(mixed $notifiable): ?string
    60	    {
    61	        if (is_string($notifiable)) {
    62	            return $notifiable;
    63	        }
    64	
    65	        if (is_object($notifiable)) {
    66	            if (property_exists($notifiable, 'email')) {
    67	                return $notifiable->email;
    68	            }
    69	
    70	            if (method_exists($notifiable, 'getEmail')) {
    71	                return $notifiable->getEmail();
    72	            }
    73	
    74	            if (method_exists($notifiable, 'routeNotificationFor')) {
    75	                return $notifiable->routeNotificationFor('mail');
    76	            }
    77	        }
    78	
    79	        return null;
    80	    }
    81	
    82	    private function buildBody(MailNotificationContent $mailNotificationContent): string
    83	    {
    84	        $html = '<html><body style="font-family: sans-serif; max-width: 600px; margin: 0 auto; padding: 20px;">';
    85	
    86	        if ($mailNotificationContent->greeting !== '') {
    87	            $html .= sprintf('<h2>%s</h2>', $mailNotificationContent->greeting);
    88	        }
    89	
    90	        if ($mailNotificationContent->line !== '') {
    91	            $html .= sprintf('<p>%s</p>', $mailNotificationContent->line);
    92	        }
    93	
    94	        foreach ($mailNotificationContent->lines as $line) {
    95	            $html .= sprintf('<p>%s</p>', $line);
    96	        }
    97	
    98	        if ($mailNotificationContent->actionText !== '' && $mailNotificationContent->actionUrl !== '') {
    99	            $html .= '<p><a href="'.htmlspecialchars($mailNotificationContent->actionUrl).'" style="display: inline-block; padding: 10px 20px; background-color: #3490dc; color: #ffffff; text-decoration: none; border-radius: 4px;">'.htmlspecialchars($mailNotificationContent->actionText).'</a></p>';
   100	        }

