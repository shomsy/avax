{
  "name": "avax/avax",
  "description": "Capability-first, runtime-agnostic PHP framework for building, testing, and evolving system-design-grade application architectures",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "framework",
    "php",
    "system-design",
    "architecture",
    "enterprise"
  ],
  "require": {
    "php": ">=8.5",
    "eftec/bladeone": "^4.16",
    "erusev/parsedown": "^1.7",
    "firebase/php-jwt": "^6.10",
    "guzzlehttp/psr7": "^2.9"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^10.5",
    "rector/type-perfect": "^2.1",
    "vimeo/psalm": "^6.16"
  },
    "autoload": {
      "psr-4": {
        "Avax\\Framework\\": "framework/",
        "Avax\\Components\\": "components/"
      },
      "files": [
        "components/Application/Container/System/PublicSurface/shortcuts.php"
      ]
    },
  "autoload-dev": {
    "psr-4": {
      "Avax\\Tests\\": "tests/"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "config": {
    "sort-packages": true,
    "audit": {
      "block-insecure": false
    }
    }
}
