namespace Avax\HTTP\Session\Foundation;

use Avax\Foundation\HTTP\Session\FlashSession\FlashSession;
use Avax\Foundation\HTTP\Session\SessionEvents\SessionEventBus;
use Avax\Foundation\HTTP\Session\SessionInterface;
use Avax\Foundation\HTTP\Session\SessionScope;
use Avax\Foundation\HTTP\Session\SessionStore\ArraySessionStore;
use Avax\Foundation\HTTP\Session\SessionStore\SessionStore;

final class NullSession implements SessionInterface
{
    private array $data = [];
    private FlashSession    $flash;
    private SessionEventBus $events;
    private SessionStore    $store;

    public function __construct(SessionStore|null $store = null)
    {
        $this->store  = $store ?? new ArraySessionStore();
        $this->flash  = new FlashSession($this->store);
        $this->events = new SessionEventBus();
    }

    public function put(string $key, mixed $value, int|null $ttl = null) : void
    {
        $this->data[$key] = $value;
    }

    public function get(string $key, mixed $default = null) : mixed
    {
        return $this->data[$key] ?? $default;
    }

    public function has(string $key) : bool
    {
        return isset($this->data[$key]);
    }

    public function forget(string $key) : void
    {
        unset($this->data[$key]);
    }

    public function delete(string $key) : void
    {
        $this->forget($key);
    }

    public function all() : array
    {
        return $this->data;
    }

    public function flush() : void
    {
        $this->data = [];
    }

    public function remember(string $key, callable $callback, int|null $ttl = null) : mixed
    {
        if ($this->has($key)) {
            return $this->get($key);
        }
        $value = $callback();
        $this->put($key, $value, $ttl);
        return $value;
    }

    public function regenerate() : void {}

    public function login(string $userId, array $data = []) : void
    {
        $this->put('user_id', $userId);
        $this->put('user_data', $data);
    }

    public function terminate(string $reason = 'logout') : void
    {
        $this->flush();
    }

    public function snapshot(string $name = 'default') : void {}

    public function restore(string $name = 'default') : void {}

    public function transaction(callable $callback) : void
    {
        $callback($this);
    }

    public function scope(string $namespace) : SessionScope
    {
        return new SessionScope($namespace, $this);
    }

    public function for(string $context) : SessionScope
    {
        return $this->scope($context);
    }

    public function flash() : FlashSession
    {
        return $this->flash;
    }

    public function events() : SessionEventBus
    {
        return $this->events;
    }
}
