{
  "autoload": {
    "psr-4": {
      "Avax\\": "Foundation/"
    },
    "files": [
      "Foundation/Text/functions.php",
      "Foundation/HTTP/Router/functions.php",
      "Foundation/HTTP/Response/functions.php",
      "Foundation/Logging/functions.php",
      "Foundation/Config/functions.php",
      "Foundation/Auth/functions.php",
      "Foundation/View/functions.php",
      "Foundation/HTTP/Session/functions.php",
      "Foundation/HTTP/Context/functions.php",
      "Foundation/DataFoundation/functions.php",
      "Foundation/Database/functions.php",
      "Foundation/Container/functions.php",
      "Foundation/HTTP/Security/functions.php",
      "Foundation/DumpDebugger/functions.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Avax\\Tests\\": "tests/"
    },
    "files": [
      "tests/TestCase.php"
    ]
  },
  "require-dev": {
    "phpstan/phpstan": "^2.0",
    "phpstan/phpstan-strict-rules": "^2.0",
    "vimeo/psalm": "^5.26",
    "infection/infection": "^0.29",
    "rector/rector": "^1.2",
    "friendsofphp/php-cs-fixer": "^3.63",
    "squizlabs/php_codesniffer": "^3.7",
    "qossmic/deptrac": "^2.0",
    "nunomaduro/phpinsights": "^2.11",
    "barryvdh/laravel-ide-helper": "^3.1",
    "tracy/tracy": "^2.3",
    "phpstan/phpdoc-parser": "^1.26",
    "phpunit/phpunit": "^11.0",
    "swoole/ide-helper": "^5.1"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "phpstan/extension-installer": true,
      "infection/extension-installer": true
    }
  },
  "require": {
    "php": ">=8.5",
    "ext-pdo": "*",
    "vlucas/phpdotenv": "^5.6",
    "guzzlehttp/guzzle": "^7.9",
    "rector/type-perfect": "^0.1.8",
    "symfony/var-dumper": "^7.1",
    "spatie/ignition": "^1.15",
    "meridius/yadup": "^1.1",
    "ext-simplexml": "*",
    "psr/log": "^3.0",
    "psr/container": "^2.0",
    "ext-fileinfo": "*",
    "firebase/php-jwt": "^6.10",
    "eftec/bladeone": "^4.16",
    "ramsey/uuid": "^4.7",
    "jenssegers/blade": "^2.0",
    "clickfwd/yoyo": "^0.2.0",
    "illuminate/view": "11.7.0",
    "sentry/sentry": "^4.10",
    "amphp/amp": "^3.0",
    "amphp/parallel-functions": "^2.0",
    "ext-curl": "*",
    "wyndow/fuzzywuzzy": "^0.6.0",
    "rakibtg/sleekdb": "^2.15",
    "psr/simple-cache": "^3.0",
    "ext-intl": "*",
    "ext-openssl": "*",
    "ext-redis": "*"
  },
  "scripts": {
    "analyse": "phpstan analyse --memory-limit=1G",
    "style": "php-cs-fixer fix --dry-run --diff",
    "style:fix": "php-cs-fixer fix",
    "architecture": "deptrac analyse",
    "refactor:dry": "rector process --dry-run",
    "refactor": "rector process",
    "test": "phpunit",
    "mutation": "infection --min-msi=80 --min-covered-msi=90",
    "check:superglobals": "php scripts/check-superglobals.php"
  },
  "suggest": {}
}
