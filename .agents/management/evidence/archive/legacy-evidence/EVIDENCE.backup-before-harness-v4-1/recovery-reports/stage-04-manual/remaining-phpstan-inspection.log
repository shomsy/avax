== RegisterDependency interface ==
     1	<?php
     2	
     3	declare(strict_types=1);
     4	
     5	namespace Avax\Components\Application\Container\System\Capabilities\Declaration\Providers;
     6	
     7	use Avax\Components\Application\Container\System\ContainerInterface;
     8	
     9	/**
    10	 * Service provider contract for deterministic registration.
    11	 */
    12	interface RegisterDependency
    13	{
    14	    /**
    15	     * Creates one provider bound to one container facade.
    16	     */
    17	    public function __construct(ContainerInterface $container);
    18	
    19	    /**
    20	     * Returns provider dependencies that must be resolved first.
    21	     *
    22	     * @return list<class-string<RegisterDependency>>
    23	     */
    24	    public function dependsOn(): array;
    25	
    26	    /**
    27	     * Registers provider-owned services.
    28	     */
    29	    public function register(): void;
    30	
    31	    /**
    32	     * Boots provider-owned side effects after registration.
    33	     */
    34	    public function boot(): void;
    35	}

