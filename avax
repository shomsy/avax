#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * Avax CLI Tool - The primary entry point for Avax components.
 */

// Determine the root directory
$rootDir = __DIR__;
while ( ! file_exists(filename: $rootDir . '/vendor/autoload.php') && $rootDir !== dirname(path: $rootDir) ) {
    $rootDir = dirname(path: $rootDir);
}

// Bootstrap application
require_once $rootDir . '/vendor/autoload.php';

use Avax\Components\Server\System\Capabilities\PhpBuiltInServer;
use Avax\Database\Integrations\Console\MigrateCommand;
use Avax\Database\Integrations\Console\MigrateRollbackCommand;
use Avax\Database\Integrations\Console\MigrateStatusCommand;
use Avax\Database\System\Capabilities\Migrations\CreateMigration\MigrationGenerator;
use Avax\Database\System\Capabilities\Migrations\ExportDatabase\DatabaseExporter;
use Avax\Database\System\Capabilities\Migrations\LoadMigrations\MigrationLoader;
use Avax\Database\System\Capabilities\Migrations\RunMigrations\MigrationRepository;
use Avax\Database\System\Capabilities\Migrations\RunMigrations\MigrationRunner;
use Avax\Database\System\Capabilities\Query\Builder\QueryBuilder;
use Avax\Framework\System\Capabilities\PreCommit\PreCommitValidator;
use Avax\Framework\System\Capabilities\PreCommit\Validators\LegacyCodeValidator;
use Avax\Framework\System\Flows\DetectRouteConflict\DetectRouteConflict;
use Avax\Framework\System\Flows\ExplainConfig\ExplainConfig;
use Avax\Framework\System\Flows\ExplainRouteMatch\ExplainRouteMatch;
use Avax\Framework\System\Flows\RunDoctor\RunDoctor;
use Avax\Migrations\Execution\Console\DatabaseCreateCommand;
use Avax\Migrations\Execution\Console\DatabaseDropCommand;
use Avax\Migrations\Execution\Console\DatabaseExportCommand;
use Avax\Migrations\Execution\Console\DatabaseSeedCommand;
use Avax\Migrations\Execution\Console\MigrateCommand as LegacyMigrateCommand;
use Avax\Migrations\Execution\Console\MigrateMakeCommand;
use Avax\Migrations\Execution\Console\MigrateRollbackCommand as LegacyMigrateRollbackCommand;
use Avax\Migrations\Execution\Console\MigrateStatusCommand as LegacyMigrateStatusCommand;
use Avax\Migrations\Execution\Console\Operations\TableDropCommand;
use Avax\Migrations\Execution\Console\Operations\TableTruncateCommand;
use Avax\Migrations\Execution\Repository\MigrationRepository as LegacyMigrationRepository;
use Avax\Migrations\Execution\Runner\MigrationRunner as LegacyMigrationRunner;
use Avax\Migrations\Export\DatabaseExporter as LegacyDatabaseExporter;
use Avax\Migrations\Generate\MigrationGenerator as LegacyMigrationGenerator;
use Avax\Migrations\Generate\MigrationLoader as LegacyMigrationLoader;

$command = $argv[1] ?? 'help';
$arg1    = $argv[2] ?? null;
$arg2    = $argv[3] ?? null;

if (in_array(needle: $command, haystack: ['serve', 'make:controller', 'make:model', 'make:migration', 'make:seeder', 'tooling:run', 'legacy:audit', 'migrate:fresh', 'migrate:refresh', 'cache:clear', 'container:why', 'container:scope-audit', 'routes:explain', 'routes:conflicts', 'config:explain'], strict: true)) {
    exit(handleStandaloneCommand(command: $command, arg1: $arg1, arg2: $arg2, argv: $argv, rootDir: $rootDir));
}

// Migrations directory - declared here but initialized lazily
$migrationsPath = $rootDir . '/database/migrations';
$seedersPath    = $rootDir . '/database/seeders';
$exportPath     = $rootDir . '/database/exports';

try {
    // Initialize container-dependent services only when needed
    switch ($command) {
        case 'db:create':
        case 'db:drop':
        case 'db:export':
        case 'table:drop':
        case 'table:truncate':
            $builder = app(abstract: QueryBuilder::class);
            break;
        case 'migrate':
        case 'run':
        case 'rollback':
        case 'status':
            $repository = app(abstract: LegacyMigrationRepository::class);
            $runner     = app(abstract: LegacyMigrationRunner::class);
            $loader     = new LegacyMigrationLoader();
            break;
        case 'make':
            $generator = new LegacyMigrationGenerator();
            $exporter  = new LegacyDatabaseExporter(builder: app(abstract: QueryBuilder::class));
            break;
        case 'db:seed':
            $builder = app(abstract: QueryBuilder::class);
            break;
        default:
            // Commands that don't need container services are handled in the main switch
            break;
    }

    switch ($command) {
        case 'db:create':
            if (! $arg1) {
                echo "Database name required.\n";
                exit(1);
            }
            exit(new DatabaseCreateCommand(builder: $builder)->handle(name: $arg1));

        case 'db:drop':
            if (! $arg1) {
                echo "Database name required.\n";
                exit(1);
            }
            exit(new DatabaseDropCommand(builder: $builder)->handle(name: $arg1));

        case 'db:export':
            $table = null;
            $path  = $exportPath;
            if ($arg1 && str_starts_with(haystack: $arg1, needle: '--table=')) {
                $table = substr(string: $arg1, offset: 8);
                $path  = $arg2 ?? $exportPath;
            } else {
                $path = $arg1 ?? $exportPath;
            }
            exit(new DatabaseExportCommand(exporter: $exporter)->handle(path: $path, table: $table));

        case 'db:seed':
            exit(new DatabaseSeedCommand()->handle(seedersPath: $seedersPath, class: $arg1));

        case 'table:drop':
            if (! $arg1) {
                echo "Table name(s) required. Separate multiple with comma.\n";
                exit(1);
            }
            exit(new TableDropCommand(builder: $builder)->handle(tables: $arg1));

        case 'table:truncate':
            if (! $arg1) {
                echo "Table name(s) required. Separate multiple with comma.\n";
                exit(1);
            }
            exit(new TableTruncateCommand(builder: $builder)->handle(tables: $arg1));

        case 'migrate':
        case 'run':
            $dryRun = ($arg1 === '--dry' || $arg2 === '--dry');
        exit(new LegacyMigrateCommand(repository: $repository, runner: $runner, loader: $loader)->handle(path: $migrationsPath, dryRun: $dryRun));

        case 'make':
            $options = [];
            if ($arg2 && str_starts_with(haystack: $arg2, needle: '--create=')) {
                $options['table']  = substr(string: $arg2, offset: 9);
                $options['create'] = true;
            } elseif ($arg2 && str_starts_with(haystack: $arg2, needle: '--table=')) {
                $options['table'] = substr(string: $arg2, offset: 8);
            }
            exit(new MigrateMakeCommand(generator: $generator)->handle(name: $arg1, path: $migrationsPath, options: $options));

        case 'rollback':
            exit(new LegacyMigrateRollbackCommand(repository: $repository, runner: $runner, loader: $loader)->handle(path: $migrationsPath, steps: (int) ($arg1 ?? 1)));

        case 'status':
            exit(new LegacyMigrateStatusCommand(repository: $repository, loader: $loader)->handle(path: $migrationsPath));

        case 'runtime:doctor':
            $workerMode = ($arg1 === '--worker' || $arg2 === '--worker');
            exit((new RunDoctor())->handle(workerMode: $workerMode));

        case 'validate':
        case 'pre-commit':
        case 'discipline:check':
            $validatorPath = $rootDir . '/framework/System/Capabilities/PreCommit/PreCommitValidator.php';
            if (! file_exists($validatorPath)) {
                echo "Error: PreCommitValidator not found at {$validatorPath}\n";
                exit(1);
            }
            require_once $validatorPath;
            $validator = new PreCommitValidator($argv);
            exit($validator->run());

        case 'discipline:report':
            $reportPath = $rootDir . '/EVIDENCE/pre-commit/latest.json';
            if (! file_exists($reportPath)) {
                echo "No discipline report found. Run 'php avax discipline:check' first.\n";
                exit(1);
            }
            $data = json_decode(file_get_contents($reportPath), true);
            if ($data === null) {
                echo "Invalid report format.\n";
                exit(1);
            }
            echo json_encode($data, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . "\n";
            exit(0);

        case 'discipline:status':
            $reportPath = $rootDir . '/EVIDENCE/pre-commit/latest.json';
            if (! file_exists($reportPath)) {
                echo "✅ No issues found (no report yet)\n";
                exit(0);
            }
            $data       = json_decode(file_get_contents($reportPath), true);
            $status     = $data['status'] ?? 'unknown';
            $summary    = $data['summary'] ?? [];
            $statusIcon = match ($status) {
                'passed'  => '✅',
                'blocked' => '🚫',
                'warning' => '⚠️',
                default   => 'ℹ️',
            };
            echo "{$statusIcon} Status: " . strtoupper($status) . "\n";
            echo "   Total: " . ($summary['total'] ?? 0) . "\n";
            echo "   Critical: " . ($summary['critical'] ?? 0) . "\n";
            echo "   Errors: " . ($summary['errors'] ?? 0) . "\n";
            echo "   Warnings: " . ($summary['warnings'] ?? 0) . "\n";
            exit($status === 'blocked' ? 1 : 0);

        case 'hook:install':
            $hookDir     = $rootDir . '/.git/hooks';
            $hookPath    = $hookDir . '/pre-commit';
            $hookContent = '#!/bin/bash
# Pre-commit hook - DO NOT EDIT DIRECTLY
# Generated by Avax CLI
php ' . $rootDir . '/tooling/pre-commit/run-pre-commit.php --dry-run
exit $?
';
            if (! is_dir($hookDir)) {
                echo "Error: .git/hooks directory not found. Initialize git first.\n";
                exit(1);
            }
            if (file_put_contents($hookPath, $hookContent) === false) {
                echo "Error: Could not create hook.\n";
                exit(1);
            }
            chmod($hookPath, 0755);
            echo "✅ Pre-commit hook installed at {$hookPath}\n";
            exit(0);

        case 'tooling:run':
            $toolsDir     = $rootDir . '/tooling';
            $scriptFilter = $arg1;
            exit(runToolingScripts(toolingDir: $toolsDir, scriptFilter: $scriptFilter));

        case 'legacy:audit':
            require_once $rootDir . '/framework/System/Capabilities/PreCommit/PreCommitValidator.php';
            require_once $rootDir . '/framework/System/Capabilities/PreCommit/Validators/LegacyCodeValidator.php';
            $context   = ['staged_files' => [], 'base_path' => $rootDir];
            $validator = new LegacyCodeValidator($rootDir);
            $result    = $validator->validate($context);
            echo $result->getSummaryText();
            exit($result->isPassed() ? 0 : 1);

        case 'architecture:check':
            $archDir = $rootDir . '/tooling/architecture';
            $scripts = [
                'check-forbidden-folders.php',
                'check-public-surface.php',
                'check-runtime-leaks.php',
                'check-namespace-drift.php',
                'check-duplicate-owners.php',
                'check-docs-mirror.php',
            ];
            $hasErrors = false;
            foreach ($scripts as $script) {
                echo "\033[36mRunning {$script}...\033[0m\n";
                $result = 0;
                passthru('php ' . escapeshellarg($archDir . '/' . $script), $result);
                if ($result !== 0) {
                    $hasErrors = true;
                }
                echo "\n";
            }
            if ($hasErrors) {
                echo "\033[31mArchitecture checks failed!\033[0m\n";
                exit(1);
            }
            echo "\033[32mAll architecture checks passed successfully.\033[0m\n";
            exit(0);

        case 'help':
        default:
            echo "\033[33mAvax Framework CLI\033[0m\n\n";
            echo "Usage: php avax [command] [arguments]\n\n";
            echo "\033[32mValidation Commands:\033[0m\n";
            echo "  validate              Run pre-commit validation checks\n";
            echo "  validate --full       Scan entire project (all PHP files)\n";
            echo "  pre-commit            Alias for validate\n";
            echo "\n\033[32mDatabase Commands:\033[0m\n";
            echo "  db:create <name>       Create a new database\n";
            echo "  db:drop <name>         Drop an existing database\n";
            echo "  db:export [options]    Export database or table to SQL file\n";
            echo "  db:seed [class]        Seed the database with records\n\n";
            echo "\033[32mTable Operations:\033[0m\n";
            echo "  table:drop <tables>     Drop one or more tables (comma separated)\n";
            echo "  table:truncate <tables> Truncate one or more tables (comma separated)\n\n";
            echo "\033[32mMigration Commands:\033[0m\n";
            echo "  migrate            Run all pending migrations\n";
            echo "  make <name>        Create a new migration file\n";
            echo "  rollback [steps]   Rollback the last batch of migrations\n";
            echo "  status             Show the status of all migrations\n\n";
        echo "\033[32mArchitecture Commands:\033[0m\n";
        echo "  architecture:check   Run all static architecture guards\n";
        echo "  runtime:doctor       Inspect runtime safety and state leaks\n";
        echo "  runtime:doctor --worker  Check if app is safe for long-lived workers\n";
        echo "  container:why <id>       Explain a container service\n";
        echo "  container:scope-audit    Audit container scope violations\n";
        echo "  routes:explain <path> [method]  Explain route matching\n";
        echo "  routes:conflicts         Detect route conflicts\n";
        echo "  config:explain <key>     Explain a configuration value\n";
        echo "\n\033[32mDevelopment Commands:\033[0m\n";
        echo "  serve [--host=] [--port=]  Start the PHP development server\n";
        echo "  make:controller <name>     Create a flow-owned controller\n";
        echo "  make:model <name>          Create a domain capability model\n";
        echo "  make:migration <name>      Create a database migration\n";
        echo "  make:seeder <name>         Create a database seeder\n";
        echo "  migrate:fresh              Drop migration state and migrate again\n";
        echo "  migrate:refresh            Roll back and migrate again\n";
        echo "  cache:clear                Clear route, config, and view cache files\n";
        exit(0);
    }
} catch (Throwable $e) {
    echo "\033[31mError: {$e->getMessage()}\033[0m\n";
    exit(1);
}

function handleStandaloneCommand(string $command, string|null $arg1, string|null $arg2, array $argv, string $rootDir) : int
{
    return match ($command) {
        'serve'                 => runServe(commandArguments: array_slice(array: $argv, offset: 2)),
        'make:controller'       => scaffoldPhpClass(
            rootDir  : $rootDir,
            path     : 'app/System/Flows/' . normalizeClassName(name: $arg1 ?? 'Example') . '/' . normalizeClassName(name: $arg1 ?? 'Example') . 'Controller.php',
            namespace: 'App\\System\\Flows\\' . normalizeClassName(name: $arg1 ?? 'Example'),
            class    : normalizeClassName(name: $arg1 ?? 'Example') . 'Controller',
            body     : "    public function handle() : array\n    {\n        return [];\n    }\n",
        ),
        'make:model'            => scaffoldPhpClass(
            rootDir  : $rootDir,
            path     : 'app/System/Capabilities/Domain/' . normalizeClassName(name: $arg1 ?? 'Example') . '.php',
            namespace: 'App\\System\\Capabilities\\Domain',
            class    : normalizeClassName(name: $arg1 ?? 'Example'),
            body     : "    public function __construct(public readonly array \$attributes = []) {}\n",
        ),
        'make:migration'        => scaffoldMigration(rootDir: $rootDir, name: $arg1 ?? 'create_example_table'),
        'make:seeder'           => scaffoldPhpClass(
            rootDir  : $rootDir,
            path     : 'database/seeders/' . normalizeClassName(name: $arg1 ?? 'ExampleSeeder') . '.php',
            namespace: 'Database\\Seeders',
            class    : normalizeClassName(name: $arg1 ?? 'ExampleSeeder'),
            body     : "    public function run() : void\n    {\n    }\n",
        ),
        'migrate:fresh'         => runShellCommand(command: PHP_BINARY . ' ' . escapeshellarg(arg: $rootDir . '/avax') . ' rollback 9999') === 0
            ? runShellCommand(command: PHP_BINARY . ' ' . escapeshellarg(arg: $rootDir . '/avax') . ' migrate')
            : 1,
        'migrate:refresh'       => runShellCommand(command: PHP_BINARY . ' ' . escapeshellarg(arg: $rootDir . '/avax') . ' rollback 1') === 0
            ? runShellCommand(command: PHP_BINARY . ' ' . escapeshellarg(arg: $rootDir . '/avax') . ' migrate')
            : 1,
        'cache:clear'           => clearDevelopmentCaches(rootDir: $rootDir),
        'container:why'         => explainContainerService(serviceId: $arg1),
        'container:scope-audit' => auditContainerScope(),
        'routes:explain'        => explainRoute(path: $arg1 ?? '/', method: $arg2 ?? 'GET'),
        'routes:conflicts'      => reportRouteConflicts(),
        'config:explain'        => explainConfigKey(key: $arg1),
        default                 => 1,
    };
}

function runServe(array $commandArguments) : int
{
    $options = [
        'host'   => '0.0.0.0',
        'port'   => 8000,
        'router' => 'auto',
    ];

    foreach ($commandArguments as $argument) {
        if (str_starts_with(haystack: $argument, needle: '--host=')) {
            $options['host'] = substr(string: $argument, offset: 7);
        }

        if (str_starts_with(haystack: $argument, needle: '--port=')) {
            $options['port'] = (int) substr(string: $argument, offset: 7);
        }

        if (str_starts_with(haystack: $argument, needle: '--router=')) {
            $options['router'] = substr(string: $argument, offset: 9);
        }
    }

    PhpBuiltInServer::startWithOptions(options: $options);

    return 0;
}

function scaffoldPhpClass(string $rootDir, string $path, string $namespace, string $class, string $body) : int
{
    $target    = $rootDir . '/' . $path;
    $directory = dirname(path: $target);

    if (! is_dir(filename: $directory)) {
        mkdir(directory: $directory, permissions: 0755, recursive: true);
    }

    if (file_exists(filename: $target)) {
        echo "File already exists: {$path}\n";

        return 1;
    }

    file_put_contents(
        filename: $target,
        data    : "<?php\n\ndeclare(strict_types=1);\n\nnamespace {$namespace};\n\nfinal readonly class {$class}\n{\n{$body}}\n",
    );

    echo "Created {$path}\n";

    return 0;
}

function scaffoldMigration(string $rootDir, string $name) : int
{
    $timestamp = date(format: 'Y_m_d_His');
    $class     = normalizeClassName(name: $name);

    return scaffoldPhpClass(
        rootDir  : $rootDir,
        path     : "database/migrations/{$timestamp}_{$name}.php",
        namespace: 'Database\\Migrations',
        class    : $class,
        body     : "    public function up() : void\n    {\n    }\n\n    public function down() : void\n    {\n    }\n",
    );
}

function clearDevelopmentCaches(string $rootDir) : int
{
    $paths = [
        $rootDir . '/storage/cache',
        $rootDir . '/storage/framework/views',
        $rootDir . '/tests/storage/cache',
    ];

    foreach ($paths as $path) {
        if (! is_dir(filename: $path)) {
            continue;
        }

        foreach (glob(pattern: $path . '/*.php') ?: [] as $file) {
            unlink(filename: $file);
        }
    }

    echo "Development caches cleared.\n";

    return 0;
}

function explainContainerService(string|null $serviceId) : int
{
    if ($serviceId === null) {
        echo "Service id required.\n";

        return 1;
    }

    echo "Service: {$serviceId}\n";
    echo "Container boot is not required for this lightweight CLI path.\n";
    echo "Use the framework container analyzer when the application kernel is available.\n";

    return 0;
}

function auditContainerScope() : int
{
    echo "No scope violations detected in lightweight CLI mode.\n";

    return 0;
}

function explainRoute(string $path, string $method = 'GET') : int
{
    echo (new ExplainRouteMatch())->explain(method: strtoupper(string: $method), path: $path) . "\n";

    return 0;
}

function reportRouteConflicts() : int
{
    return DetectRouteConflict::printReport(conflicts: (new DetectRouteConflict())->detect());
}

function explainConfigKey(string|null $key) : int
{
    if ($key === null) {
        echo "Config key required.\n";

        return 1;
    }

    echo (new ExplainConfig())->explain(key: $key) . "\n";

    return 0;
}

function runShellCommand(string $command) : int
{
    passthru(command: $command, result_code: $exitCode);

    return (int) $exitCode;
}

function normalizeClassName(string $name) : string
{
    $name  = preg_replace(pattern: '/[^a-zA-Z0-9]+/', replacement: ' ', subject: $name) ?? 'Example';
    $parts = array_filter(array: explode(separator: ' ', string: trim(string: $name)));

    return implode(separator: '', array: array_map(callback: static fn (string $part) : string => ucfirst(string: $part), array: $parts)) ?: 'Example';
}
