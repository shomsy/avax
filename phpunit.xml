<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" bootstrap="vendor/autoload.php" colors="true"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/10.5/phpunit.xsd" cacheDirectory=".phpunit.cache">
    <coverage>
        <report>
            <clover outputFile="build/logs/clover.xml"/>
        </report>
    </coverage>
    <testsuites>
        <testsuite name="Container">
            <directory>tests/Foundation/Container</directory>
        </testsuite>
        <testsuite name="Database">
            <directory>tests/Foundation/Database</directory>
        </testsuite>
        <testsuite name="DataLayer">
            <directory>tests/Foundation/DataLayer</directory>
        </testsuite>
        <testsuite name="ApplicationWorkflow">
            <directory>tests/Foundation/ApplicationWorkflow</directory>
        </testsuite>
        <testsuite name="Router">
            <directory>tests/Foundation/HTTP/Router</directory>
        </testsuite>
        <testsuite name="Request">
            <directory>tests/Unit/Foundation/HTTP/Request</directory>
        </testsuite>
    </testsuites>
    <logging/>
    <source/>
</phpunit>
