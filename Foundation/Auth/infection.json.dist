{
  "$schema": "https://infection.github.io/schema.json",
  "source": {
    "directories": [
      "System/Flow/Mfa",
      "System/Flow/ChangePassword",
      "System/Capability/Identity",
      "System/Flow/Token",
      "System/Flow/Session",
      "System/Flow/Logout",
      "System/Flow/Recover",
      "System/Capability/PasswordHashing",
      "System/Capability/OAuth/SenderConstraint",
      "System/Flow/OAuth/ExchangeRefreshToken",
      "System/Flow/Mfa/Recover"
    ]
  },
  "logs": {
    "summary": "build/infection-summary.log"
  },
  "phpUnit": {
    "configDir": "."
  },
  "mutators": {
    "@default": true
  },
  "timeout": 10
}
