    public function __invoke() : array
    {
        return $this->flatten();
    }

    public function flatten() : array
    {
        $result = [];

        foreach ($this->items as $key => $value) {
            if (is_array(value: $value)) {
                $result = $this->flattenRecursive(result: $result, prefix: $key, items: $value);
            } else {
                $result[$key] = $value;
