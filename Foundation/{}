    /**
     * @return list<string>
     */
    private function visibleServiceIdsForSlice(string $slice) : array
    {
        return array_values(array: array_map(
                                callback: static fn (array $row) : string => $row['serviceId'],
                                array   : $this->registrations->sliceView(slice: $slice)['visible'] ?? []
                            ));
