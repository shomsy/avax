    case DOCUMENT    = 'document';
    case KEY_VALUE   = 'key_value';
    case SEARCH      = 'search';
    case WIDE_COLUMN = 'wide_column';
    case GRAPH       = 'graph';
    case COLUMNAR    = 'columnar';
}
